<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚀 ASTRA-BIO"
            android:textColor="#e6edf3"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Offline spaceflight-vs-Earth comparative analysis (Python + SciPy embedded)"
            android:textColor="#8b949e"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Run Offline Demo (phenotypes + 3 omics)" />

        <TextView
            android:id="@+id/status_earth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Earth CSV: not picked"
            android:textColor="#8b949e" />

        <TextView
            android:id="@+id/status_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Space CSV: not picked"
            android:textColor="#8b949e" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_pick_earth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pick Earth CSV" />

            <Button
                android:id="@+id/btn_pick_space"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pick Space CSV" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_analyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze Uploaded Files" />

        <EditText
            android:id="@+id/osdr_accession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="NASA OSDR accession, e.g. OSD-48 (needs internet)"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e" />

        <Button
            android:id="@+id/btn_osdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetch OSDR Metadata" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#161b22"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="Results appear here."
                android:textColor="#e6edf3"
                android:textSize="12sp" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Statistics are automated; biological judgment is not. Verify all results."
            android:textColor="#8b949e"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
